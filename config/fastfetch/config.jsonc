{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌──────────────── Hardware ────────────────┐"
    },
    {
      "type": "cpu",
      "key": " ├─  ",
      "keyColor": "38;5;240"
    },
    {
      "type": "gpu",
      "key": " ├─ 󰍛 ",
      "keyColor": "38;5;240"
    },
    {
      "type": "memory",
      "key": " ├─ 󰘚 ",
      "keyColor": "38;5;240"
    },
    {
      "type": "custom",
      "format": "└──────────────────────────────────────────┘"
    },
    {
      "type": "custom",
      "format": "┌──────────────── Software ─────────────────┐"
    },
    {
      "type": "os",
      "key": " ├─ 󰌽 ",
      "keyColor": "38;5;240"
    },
    {
      "type": "kernel",
      "key": " ├─  ",
      "keyColor": "38;5;240"
    },
    {
      "type": "wm",
      "key": " ├─ 󰨇 ",
      "keyColor": "38;5;240"
    },
    {
      "type": "terminal",
      "key": " ├─ 󰞷 ",
      "keyColor": "38;5;240"
    },
    {
      "type": "shell",
      "key": " └─ 󰞷 ",
      "keyColor": "38;5;240"
    },
    {
      "type": "custom",
      "format": "└───────────────────────────────────────────┘"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}

